{
  "manifest_version": 3,
  "name": "Inbox Arcade",
  "version": "0.1.0",
  "description": "A new front end for Gmail on the official API, with an Inbox Zero game mode.",
  "key": "",
  "action": {
    "default_title": "Open Inbox Arcade"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "identity"
  ],
  "host_permissions": [
    "https://gmail.googleapis.com/*"
  ]
}
